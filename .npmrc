# pnpm configuration for the civfix-admin workspace.
# Hoist nothing by default (strict), but allow common build tooling to be found.
auto-install-peers=true
strict-peer-dependencies=false
# Keep the lockfile honest in CI-like runs.
prefer-workspace-packages=true
link-workspace-packages=true
# @civfix/contract and @civfix/tokens are consumed from the private registry (anonymous read; auth only to publish).
@civfix:registry=https://repo.civfix.org/
# Fail the install when a package declares a Node or pnpm version this machine does not satisfy.
engine-strict=true
