{
  "name": "civfix-admin",
  "version": "1.2.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "civfix admin / operator dashboard workspace (admin.civfix.org). Consumes the @civfix/shared contract from the private npm registry.",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "turbo": "^2.3.3"
  },
  "pnpm": {
    "overrides": {
      "vite": ">=7.3.6 <8",
      "js-yaml@4": ">=4.3.1 <5",
      "brace-expansion@1": ">=1.1.18 <2",
      "brace-expansion@5": ">=5.0.9 <6",
      "nanoid@3": ">=3.3.18 <4",
      "postcss": ">=8.5.28 <9",
      "browserslist": ">=4.28.9 <5",
      "postcss-selector-parser@6": ">=6.1.4 <7"
    }
  }
}
