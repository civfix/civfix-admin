{
  "name": "civfix-admin",
  "version": "1.4.1",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "civfix admin / operator dashboard workspace (admin.civfix.org). Consumes @civfix/contract and @civfix/tokens from the private npm registry.",
  "packageManager": "pnpm@12.17.0+sha512.b8d223ebec04b580a89ed206daa71d1bccb6a1ee1d52efa95cc3b0db75271561df8f0d8e2c43add39c5ec08018af7a8a95108e7090f95a29f88727b7a40fd53d",
  "engines": {
    "node": "^24.15"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "clean": "turbo run clean",
