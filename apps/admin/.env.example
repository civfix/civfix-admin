# civfix admin / operator dashboard environment (admin.civfix.org).
#
# NEXT_PUBLIC_* values are INLINED into the static export at BUILD time (not read at runtime). Set
# them before `pnpm -C apps/admin build` (or `pnpm build` from the repo root). In CI they come from
# repo Variables (vars.*); see .github/workflows/deploy.yml.

# Base URL of the civfix API. The dashboard is served at admin.civfix.org and calls this API for all
# /admin/* data and auth; the API's WEB_ORIGINS must include https://admin.civfix.org. Defaults to the
# local backend when unset.
# Example (production): https://api.civfix.example
NEXT_PUBLIC_API_URL=http://localhost:8080
