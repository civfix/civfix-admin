# Cloudflare Pages response headers for the civfix admin / operator dashboard static export.
#
# Lives in public/ and is copied verbatim into the export output (out/_headers); Cloudflare consumes
# it at deploy time and it is NOT served as a static asset. Docs:
# https://developers.cloudflare.com/pages/configuration/headers/
#
# These headers ONLY take effect on Cloudflare Pages; `next dev` and a local static file server ignore
# this file. MERGE SEMANTICS: a header set by two matching rules is comma-JOINED, so we drop the
# inherited Cache-Control on /_next/static/* with `! Cache-Control` before setting the immutable one.

# --- Pervasive defaults: applied to every response. ---
# This is an internal operator tool: keep it out of search indexes entirely (X-Robots-Tag noindex),
# short-cache the HTML shell so a new deploy is picked up promptly, and ship strict security headers.
/*
  Cache-Control: public, max-age=0, must-revalidate
  X-Robots-Tag: noindex, nofollow
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Strict-Transport-Security: max-age=31536000
  Permissions-Policy: accelerometer=(), autoplay=(), camera=(), fullscreen=(self), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; media-src 'self' blob: https:; font-src 'self' data:; connect-src 'self' https: wss:; worker-src 'self' blob:

# --- Content-hashed build assets: cache immutably for a year. ---
# Files under /_next/static carry a content hash in their name, so a given URL never changes. Drop the
# inherited short-cache from `/*` first (see MERGE SEMANTICS above), then cache hard.
/_next/static/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
